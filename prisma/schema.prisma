generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persons {
  ff2b_id                                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name                                String
  last_name                                 String
  birthdate                                 DateTime                     @db.Date
  phone_number                              String
  email                                     String
  status                                    Int?                         @db.SmallInt
  contact_origin                            contact_origin?
  address                                   String?                      @db.VarChar(255)
  municipality_id                           Int?
  creation_date                             DateTime?                    @default(now()) @db.Timestamptz(6)
  commissions                               commissions[]
  commissions_members                       commissions_members[]
  competition_participant                   competition_participant[]
  competitions                              competitions[]
  consents                                  consents[]
  contacts_contacts_person_idTopersons      contacts[]                   @relation("contacts_person_idTopersons")
  contacts_contacts_responsible_idTopersons contacts[]                   @relation("contacts_responsible_idTopersons")
  documents_persons                         documents_persons[]
  game_participant                          game_participant[]
  game_side                                 game_side[]
  licenses                                  licenses[]
  organizations_contact                     organizations_contact[]
  payments                                  payments[]
  person_roles                              person_roles[]
  municipalities                            municipalities?              @relation(fields: [municipality_id], references: [id], onUpdate: NoAction)
  person_status                             person_status?               @relation(fields: [status], references: [id], onDelete: Restrict, onUpdate: NoAction)
  persons_documents_mentions                persons_documents_mentions[]
  projects_members                          projects_members[]
  prospects                                 prospects[]
  referents                                 referents[]
  session_participants                      session_participants[]
  sessions                                  sessions[]
  team_members                              team_members[]
  users                                     users?
  volunteers_volunteers_manager_idTopersons volunteers[]                 @relation("volunteers_manager_idTopersons")
  volunteers_volunteers_person_idTopersons  volunteers[]                 @relation("volunteers_person_idTopersons")

  @@index([birthdate], map: "idx_persons_birthdate")
  @@index([last_name], map: "idx_persons_last_name")
  @@index([municipality_id], map: "idx_persons_municipality_id")
}


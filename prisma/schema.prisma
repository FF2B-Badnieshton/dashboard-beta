generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persons {
  id         String   @id @db.Uuid
  first_name String?
  last_name  String?
  email      String   @unique
  role       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

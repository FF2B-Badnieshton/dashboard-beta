  creation_date         DateTime                @db.Timestamptz(6)
  persons               persons                 @relation(fields: [president_id], references: [ff2b_id], onUpdate: NoAction)
  commissions_members   commissions_members[]
  documents_commissions documents_commissions[]

  @@index([name], map: "idx_commissions_name")
  @@index([president_id], map: "idx_commissions_president_id")
